+++ b/third_party/blink/renderer/core/timezone/timezone_controller.cc
@@ -149,6 +149,12 @@
 TimeZoneController::SetTimeZoneOverride(const String& timezone_id) {
   DCHECK(!timezone_id.empty());
 
+  // ICU conversions below use NUL-terminated identifiers. Reject embedded NULs
+  // before canonical comparisons so a valid prefix cannot be accepted.
+  if (timezone_id.contains('\0')) {
+    return {TimeZoneOverrideStatus::kInvalidTimezone, nullptr};
+  }
+
   base::AutoLock locker(instance().lock_);
 
   if (timezone_id == instance().TimeZoneIdOverride()) {
@@ -204,6 +210,11 @@
 // static
 bool TimeZoneController::ChangeTimeZoneOverride(const String& timezone_id) {
   DCHECK(!timezone_id.empty());
+
+  // Match acquisition validation before the canonical-equivalence early return.
+  if (timezone_id.contains('\0')) {
+    return false;
+  }
 
   base::AutoLock locker(instance().lock_);
 
