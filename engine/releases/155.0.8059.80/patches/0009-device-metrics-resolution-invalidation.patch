diff --git a/third_party/blink/renderer/core/frame/web_frame_widget_impl.cc b/third_party/blink/renderer/core/frame/web_frame_widget_impl.cc
--- a/third_party/blink/renderer/core/frame/web_frame_widget_impl.cc
+++ b/third_party/blink/renderer/core/frame/web_frame_widget_impl.cc
@@ -5324,7 +5324,15 @@
   // Emulation happens on regular main frames which don't use auto-resize mode.
   DCHECK(!AutoResizeMode());
 
+  const float previous_device_scale_factor = GetScreenInfo().device_scale_factor;
   UpdateScreenInfo(screen_infos);
+  if (previous_device_scale_factor != GetScreenInfo().device_scale_factor) {
+    // Emulation keeps the compositor's native scale. A DPR-only update can
+    // therefore leave layout size and zoom unchanged, so invalidate resolution
+    // queries explicitly for the local frame subtree.
+    LocalRootImpl()->GetFrame()->MediaQueryAffectingValueChangedForLocalSubtree(
+        MediaValueChange::kOther);
+  }
   widget_base_->SetVisibleViewportSize(visible_viewport_size);
   Resize(widget_base_->DIPsToCeiledBlinkSpace(widget_size_in_dips));
 }
diff --git a/third_party/blink/web_tests/inspector-protocol/emulation/device-metrics-resolution-change.js b/third_party/blink/web_tests/inspector-protocol/emulation/device-metrics-resolution-change.js
new file mode 100644
--- /dev/null
+++ b/third_party/blink/web_tests/inspector-protocol/emulation/device-metrics-resolution-change.js
@@ -0,0 +1,34 @@
+(async function(/** @type {import('test_runner').TestRunner} */ testRunner) {
+  const {session, dp} = await testRunner.startBlank(
+      'Tests CSS resolution invalidation and change events on DPR-only updates.');
+  const metrics = {width: 800, height: 600, mobile: false};
+  await dp.Emulation.setDeviceMetricsOverride(
+      {...metrics, deviceScaleFactor: 1});
+  await session.evaluate(() => {
+    document.body.innerHTML = '<style>:root { --density: low; }' +
+        '@media (min-resolution: 1.5dppx) { :root { --density: high; } }' +
+        '</style>';
+    window.resolutionQuery = matchMedia('(min-resolution: 1.5dppx)');
+    window.resolutionEvents = [];
+    resolutionQuery.addEventListener('change', event => {
+      resolutionEvents.push(event.matches);
+    });
+  });
+  for (const deviceScaleFactor of [2, 1.25, 2, 1]) {
+    await session.evaluate(() => { resolutionEvents.length = 0; });
+    await dp.Emulation.setDeviceMetricsOverride(
+        {...metrics, deviceScaleFactor});
+    await session.evaluate(() => new Promise(resolve => {
+      requestAnimationFrame(() => requestAnimationFrame(resolve));
+    }));
+    testRunner.log(JSON.stringify(await session.evaluate(() => ({
+      dpr: devicePixelRatio,
+      matches: resolutionQuery.matches,
+      css: getComputedStyle(document.documentElement)
+               .getPropertyValue('--density').trim(),
+      events: [...resolutionEvents],
+    }))));
+  }
+  await dp.Emulation.clearDeviceMetricsOverride();
+  testRunner.completeTest();
+})
