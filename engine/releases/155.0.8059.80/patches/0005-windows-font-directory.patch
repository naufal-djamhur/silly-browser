@@ -0,0 +1,22 @@
+// Copyright 2026 Custom Browser contributors. MIT license.
+#ifndef UI_GFX_WIN_CUSTOM_BROWSER_FONT_FILES_H_
+#define UI_GFX_WIN_CUSTOM_BROWSER_FONT_FILES_H_
+#include "base/command_line.h"
+#include "base/files/file_path.h"
+#include "base/no_destructor.h"
+#include "ui/gfx/win/custom_browser_font_directory.h"
+namespace custom_browser {
+inline const std::optional<std::vector<std::wstring>>& ConfiguredFontFiles() {
+  static const base::NoDestructor<std::optional<std::vector<std::wstring>>> files(
+      []() -> std::optional<std::vector<std::wstring>> {
+        if (!base::CommandLine::InitializedForCurrentProcess())
+          return std::vector<std::wstring>();
+        const auto& command = *base::CommandLine::ForCurrentProcess();
+        if (command.HasSwitch("type") || !command.HasSwitch("custom-browser-fonts-dir"))
+          return std::vector<std::wstring>();
+        return ReadFontDirectory(command.GetSwitchValuePath("custom-browser-fonts-dir").value());
+      }());
+  return *files;
+}
+}  // namespace custom_browser
+#endif
