+// The request owns this delegate. A queued completion is canceled if the
+// request goes away, and completion may synchronously destroy the delegate.
+class CustomBrowserProxyLoginDelegate final : public content::LoginDelegate {
+ public:
+  CustomBrowserProxyLoginDelegate(
+      LoginAuthRequiredCallback callback,
+      std::optional<net::AuthCredentials> credentials)
+      : callback_(std::move(callback)), credentials_(std::move(credentials)) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&CustomBrowserProxyLoginDelegate::Complete,
+                       weak_factory_.GetWeakPtr()));
+  }
+
+ private:
+  void Complete() {
+    auto callback = std::move(callback_);
+    auto credentials = std::move(credentials_);
+    std::move(callback).Run(credentials);
+  }
+
+  LoginAuthRequiredCallback callback_;
+  std::optional<net::AuthCredentials> credentials_;
+  base::WeakPtrFactory<CustomBrowserProxyLoginDelegate> weak_factory_{this};
+};
