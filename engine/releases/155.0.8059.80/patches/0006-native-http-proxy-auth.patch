+// Consume credentials before command-line preferences or child processes are
+// created. The standard proxy configuration contains only the sanitized URI.
+bool ConfigureCustomBrowserHttpProxy(base::CommandLine& command_line) {
+  constexpr char kProxyFile[] = "custom-browser-http-proxy-file";
+  const bool from_file = command_line.HasSwitch(kProxyFile);
+  std::string input = command_line.GetSwitchValueASCII("proxy-server");
+  if (!from_file && input.find('@') == std::string::npos) {
+    return true;  // Preserve Chromium's existing unauthenticated proxy syntax.
+  }
+  if (command_line.HasSwitch("no-proxy-server") ||
+      command_line.HasSwitch("proxy-pac-url") ||
+      command_line.HasSwitch("proxy-auto-detect")) {
+    return false;
+  }
+  if (from_file) {
+    if (command_line.HasSwitch("proxy-server")) return false;
+    const base::FilePath path = command_line.GetSwitchValuePath(kProxyFile);
+    if (!path.IsAbsolute() ||
+        !base::ReadFileToStringWithMaxSize(path, &input, 4096)) {
+      return false;
+    }
+    base::TrimWhitespaceASCII(input, base::TRIM_ALL, &input);
+  }
+  if (input.empty() || input.size() > 4096) return false;
+  for (const unsigned char c : input) {
+    if (c <= 0x20 || c > 0x7e || c == '\\') return false;
+  }
+  const GURL proxy(input);
+  // This iteration qualifies HTTP Basic proxies, including HTTPS CONNECT.
+  // PAC lists, SOCKS, TLS-to-proxy and integrated authentication are separate.
+  if (!proxy.is_valid() || !proxy.SchemeIs("http") || !proxy.has_host() ||
+      proxy.has_query() || proxy.has_ref() || proxy.path() != "/") {
+    return false;
+  }
+  auto username = custom_browser::DecodeHttpProxyCredential(proxy.username(), true);
+  auto password = custom_browser::DecodeHttpProxyCredential(proxy.password(), false);
+  if (!username || !password) return false;
+  const url::SchemeHostPort endpoint(proxy);
+  if (!endpoint.IsValid()) return false;
+  custom_browser::GetHttpProxyCredentials().emplace(
+      endpoint.Serialize(), std::move(*username), std::move(*password));
+  command_line.RemoveSwitch("proxy-server");
+  command_line.RemoveSwitch(kProxyFile);
+  command_line.AppendSwitchASCII("proxy-server", endpoint.Serialize());
+  return true;
+}
+#endif  // !defined(BUILDING_CHROME_RENDERER)
 
