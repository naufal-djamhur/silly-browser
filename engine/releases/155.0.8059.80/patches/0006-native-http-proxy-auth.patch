+// Copyright 2026 Custom Browser contributors. MIT license.
+#ifndef CHROME_COMMON_CUSTOM_BROWSER_HTTP_PROXY_STATE_H_
+#define CHROME_COMMON_CUSTOM_BROWSER_HTTP_PROXY_STATE_H_
+
+#include <optional>
+
+#include "base/no_destructor.h"
+#include "chrome/common/custom_browser_http_proxy_policy.h"
+
+namespace custom_browser {
+// Initialized by browser startup, read on the browser UI sequence. Never passed
+// to renderer or network-service command lines or persisted to preferences.
+inline std::optional<HttpProxyCredentials>& GetHttpProxyCredentials() {
+  static base::NoDestructor<std::optional<HttpProxyCredentials>> credentials;
+  return *credentials;
+}
+}  // namespace custom_browser
+#endif  // CHROME_COMMON_CUSTOM_BROWSER_HTTP_PROXY_STATE_H_
